# Set the canonical production origin before building (e.g. https://your-domain.example).
# Leave unset in previews to request no indexing.
NEXT_PUBLIC_SITE_URL=
# Optional HTTPS contact/booking destinations. Defaults to /contatti.
NEXT_PUBLIC_DEMO_URL=/contatti
NEXT_PUBLIC_CONTACT_URL=/contatti
# Placeholder only. Replace with a real mailbox to enable the mailto action.
CONTACT_EMAIL=contatti@vestora.example
